@model RaceDayMVC.Models.EventEnrolmentsViewModel

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container py-5">
    <h1 style="color:#102747; font-weight:800;">Event Enrolments</h1>

    <h5 class="text-muted mb-4">@Model.EventName</h5>

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead style="background:#102747; color:white;">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Category</th>
                        <th>Entry Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var entry in Model.Enrolments)
                    {
                        <tr>
                            <td>@entry.FirstName @entry.LastName</td>
                            <td>@entry.Email</td>
                            <td>@entry.Phone</td>
                            <td>@entry.CategoryName</td>
                            <td>@entry.EntryDate.ToString("dd MMM yyyy")</td>
                            <td>@entry.EntryStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Events"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>
</div>