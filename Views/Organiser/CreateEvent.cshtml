@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 style="color:#102747;font-weight:800;">
            Create New Event
        </h1>
        <p class="text-muted">
            Enter the details below to add a new race event.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Organiser"
                  asp-action="CreateEvent"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label fw-bold">
                        Event Name
                    </label>
                    <input asp-for="EventName" class="form-control"
                           placeholder="Enter event name" />
                    <span asp-validation-for="EventName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDescription" class="form-label fw-bold">
                        Event Description
                    </label>
                    <textarea asp-for="EventDescription"
                              class="form-control" rows="3"
                              placeholder="Describe your event"></textarea>
                    <span asp-validation-for="EventDescription"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-bold">
                        Event Date and Time
                    </label>
                    <input asp-for="EventDate"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control" />
                    <span asp-validation-for="EventDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventLocation" class="form-label fw-bold">
                        Event Location
                    </label>
                    <input asp-for="EventLocation" class="form-control"
                           placeholder="Enter event location" />
                    <span asp-validation-for="EventLocation"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RouteInformation" class="form-label fw-bold">
                        Route Information
                    </label>
                    <textarea asp-for="RouteInformation"
                              class="form-control" rows="3"
                              placeholder="Describe the race route"></textarea>
                    <span asp-validation-for="RouteInformation"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label fw-bold">
                        Distance (km)
                    </label>
                    <input asp-for="Distance" type="number"
                           step="0.01" min="0.01" max="1000"
                           class="form-control"
                           placeholder="Example: 10" />
                    <span asp-validation-for="Distance"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="EventType" class="form-label fw-bold">
                        Event Type
                    </label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn text-white px-4"
                        style="background:#f58220;">
                    Create Event
                </button>

                <a asp-controller="Organiser"
                   asp-action="Events"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
