@model List<RaceDayMVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-5">

    <h1 style="color:#102747;font-weight:800;">
        Manage Categories
    </h1>

    <p class="text-muted">
        Create and manage categories for your race events.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null || ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @(TempData["ErrorMessage"] ?? ViewBag.ErrorMessage)
        </div>
    }

    <div class="card shadow-sm border-0 my-4">
        <div class="card-body p-4">

            <h4 style="color:#102747;">Create New Category</h4>

            <form asp-action="CreateCategory" method="post">

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Category Name
                    </label>
                    <input name="CategoryName"
                           class="form-control"
                           maxlength="80"
                           required
                           placeholder="Example: 10km Open" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Description (Optional)
                    </label>
                    <textarea name="CategoryDescription"
                              class="form-control"
                              rows="3"
                              placeholder="Describe this category"></textarea>
                </div>

                <button type="submit"
                        class="btn text-white"
                        style="background:#f58220;">
                    Create Category
                </button>

            </form>
        </div>
    </div>

    <h4 style="color:#102747;" class="mb-3">
        Existing Categories
    </h4>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been created yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold" style="color:#102747;">
                                @category.CategoryName
                            </h5>

                            <p class="text-muted mb-0">
                                @(string.IsNullOrWhiteSpace(category.CategoryDescription)
                                                        ? "No description provided."
                                                        : category.CategoryDescription)
                    </p>
                </div>
            </div>
        </div>
                }
        </div>
    }

    <a asp-action="Dashboard"
       class="btn btn-outline-secondary mt-4">
        Back to Dashboard
    </a>

</div>
