
@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="color:#102747;font-weight:800;">Manage Events</h1>
            <p class="text-muted">View and manage your race events.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn text-white"
           style="background:#f58220;">
            + Create Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead style="background:#102747;color:white;">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Distance</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="fw-bold">@ev.EventName</td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@ev.EventLocation</td>
                            <td>@ev.EventType</td>
                            <td>@ev.Distance km</td>

                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-controller="Organiser"
                                       asp-action="EditEvent"
                                       asp-route-id="@ev.EventID"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="Enrolments"
                                       asp-route-eventId="@ev.EventID"
                                       class="btn btn-sm btn-outline-success">
                                        View Enrolments
                                    </a>

                                    <a asp-controller="Organiser"
                                       asp-action="Results"
                                       asp-route-eventId="@ev.EventID"
                                       class="btn btn-sm btn-outline-primary">
                                        Manage Results
                                    </a>

                                    <form asp-controller="Organiser"
                                          asp-action="DeleteEvent"
                                          asp-route-id="@ev.EventID"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-outline-secondary mt-3">
        Back to Dashboard
    </a>

</div>
