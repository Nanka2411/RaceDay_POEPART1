@model RaceDayMVC.Models.EventResultsViewModel

@{
    ViewData["Title"] = "Manage Results";
}

<div class="container py-5">

    <h1 style="color:#102747; font-weight:800;">Manage Results</h1>
    <h5 class="text-muted mb-4">@Model.EventName</h5>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="fw-bold" style="color:#102747;">
                Publish Event Results
            </h5>

            <p class="text-muted">
                Once all participants have results recorded, publish them
                so participants can view their race results.
            </p>

            <form asp-controller="Organiser"
                  asp-action="PublishResults"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.EventID" />

                <button type="submit"
                        class="btn btn-success">
                    Publish Results
                </button>
            </form>
        </div>
    </div>

    @if (Model.Entries == null || !Model.Entries.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead style="background:#102747; color:white;">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Entry ID</th>
                        <th>Race Time</th>
                        <th>Position</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.FirstName @entry.LastName</td>
                            <td>@entry.CategoryName</td>
                            <td>@entry.EntryID</td>

                            <td colspan="4">
                                <form asp-controller="Organiser"
                                      asp-action="SaveResult"
                                      method="post"
                                      class="d-flex gap-2 flex-wrap align-items-center">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="EntryID"
                                           value="@entry.EntryID" />

                                    <input type="hidden"
                                           name="eventId"
                                           value="@Model.EventID" />

                                    <input type="text"
                                           name="ResultTime"
                                           class="form-control"
                                           placeholder="HH:mm:ss"
                                           pattern="[0-9]{1,2}:[0-9]{2}:[0-9]{2}"
                                           required
                                           style="max-width:130px;" />

                                    <input type="number"
                                           name="Position"
                                           class="form-control"
                                           placeholder="Position"
                                           min="1"
                                           required
                                           style="max-width:100px;" />

                                    <select name="ResultStatus"
                                            class="form-select"
                                            style="max-width:130px;">
                                        <option value="Completed">Completed</option>
                                        <option value="DNF">DNF</option>
                                        <option value="DNS">DNS</option>
                                    </select>

                                    <button type="submit"
                                            class="btn text-white"
                                            style="background:#f58220;">
                                        Save
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Events"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>

</div>
