@model RaceDayMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: linear-gradient(135deg, #071a35, #123d68);
        min-height: 100vh;
    }

    .login-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .login-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        width: 100%;
        max-width: 900px;
        display: flex;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

    .login-info {
        background: linear-gradient(145deg, #102e50, #17609a);
        color: white;
        padding: 55px 40px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .login-info h1 {
            font-size: 38px;
            font-weight: bold;
        }

        .login-info span {
            color: #ff8c32;
        }

    .login-form {
        padding: 55px 45px;
        flex: 1;
    }

        .login-form h2 {
            color: #102e50;
            font-weight: bold;
        }

    .form-control {
        padding: 12px;
        border-radius: 8px;
    }

    .login-button {
        background: #ff812b;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: bold;
        width: 100%;
    }

        .login-button:hover {
            background: #e96c18;
            color: white;
        }

    @@media (max-width: 650px) {
        .login-card {
            flex-direction: column;
        }

        .login-info, .login-form {
            padding: 35px 25px;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-info">
            <h1>Race<span>Day</span></h1>
            <h3>Your race. Your day.</h3>
            <p>
                Manage your sporting events, entries and results
                all in one place.
            </p>
        </div>

        <div class="login-form">
            <h2>Welcome Back!</h2>
            <p class="text-muted mb-4">Sign in to your RaceDay account.</p>

            <form asp-controller="Account" asp-action="Login" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control"
                           placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control"
                           placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="login-button">
                    Sign In
                </button>

            </form>
        </div>

    </div>
</div>
