@model RaceDayMVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: linear-gradient(135deg, #071a35, #123d68);
        min-height: 100vh;
    }

    .register-wrapper {
        min-height: 90vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px 15px;
    }

    .register-card {
        background: white;
        width: 100%;
        max-width: 650px;
        padding: 40px;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.25);
    }

        .register-card h2 {
            color: #102e50;
            font-weight: bold;
        }

        .register-card .form-control,
        .register-card .form-select {
            padding: 11px;
            border-radius: 8px;
        }

    .register-button {
        background: #ff812b;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        width: 100%;
        font-weight: bold;
    }

        .register-button:hover {
            background: #e96c18;
            color: white;
        }

    .register-card label {
        font-weight: 600;
        color: #243b53;
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <h2 class="text-center">Create Your RaceDay Account</h2>
        <p class="text-center text-muted mb-4">
            Join RaceDay and get ready for your next event.
        </p>

        <form asp-controller="Account" asp-action="Register" method="post">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserRole">Account Type</label>
                <select asp-for="UserRole" class="form-select">
                    <option value="Participant">Participant</option>
                    <option value="Organiser">Organiser</option>
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName" class="form-control"
                           placeholder="Enter first name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName" class="form-control"
                           placeholder="Enter last name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="form-control"
                       placeholder="Enter email address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone">Phone Number</label>
                <input asp-for="Phone" class="form-control"
                       placeholder="Enter phone number" />
            </div>

            <div class="mb-3">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="form-control"
                       placeholder="Create a password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParticipantAge">Age (Participants)</label>
                <input asp-for="ParticipantAge" type="number"
                       class="form-control" placeholder="Enter your age" />
            </div>

            <div class="mb-3">
                <label asp-for="OrganiserName">Organiser Name</label>
                <input asp-for="OrganiserName" class="form-control"
                       placeholder="Enter organiser name" />
            </div>

            <div class="mb-4">
                <label asp-for="OrganisationName">Organisation Name</label>
                <input asp-for="OrganisationName" class="form-control"
                       placeholder="Enter organisation name" />
            </div>

            <button type="submit" class="register-button">
                Create Account
            </button>

            <p class="text-center mt-3">
                Already have an account?
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            </p>

        </form>
    </div>
</div>

